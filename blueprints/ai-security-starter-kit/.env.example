# Copy to .env. Never commit real values.
PORT=8080
LOG_LEVEL=INFO
TENANT_DEFAULT=demo
GATEWAY_URL=https://ai-gateway.example.internal
GATEWAY_API_KEY=replace-me
# AI gateway endpoint
GATEWAY_URL=https://gateway.example.internal
# Permitted egress hosts
EGRESS_ALLOWLIST=api.internal,cdn.internal
# Deny on guardrail failure
FAIL_CLOSED=true
