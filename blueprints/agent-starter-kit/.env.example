# Copy to .env. Never commit real values.
PORT=8080
LOG_LEVEL=INFO
TENANT_DEFAULT=demo
GATEWAY_URL=https://ai-gateway.example.internal
GATEWAY_API_KEY=replace-me
# Tool registry endpoint
TOOL_REGISTRY_URL=https://tools.example.internal
# Hard loop ceiling
MAX_STEPS=12
# Gate side effects
APPROVAL_REQUIRED=true
