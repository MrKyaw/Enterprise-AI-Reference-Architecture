# Copy to .env. Never commit real values.
PORT=8080
LOG_LEVEL=INFO
TENANT_DEFAULT=demo
GATEWAY_URL=https://ai-gateway.example.internal
GATEWAY_API_KEY=replace-me
# Logical corpus/index name
INDEX_NAME=enterprise-kb
# Versioned embedding model
EMBEDDING_MODEL=pinned-model-id
# Retrieval depth cap
TOP_K=8
